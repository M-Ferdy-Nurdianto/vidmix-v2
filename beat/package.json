{
  "name": "elegant-visualizer-pro",
  "version": "1.0.0",
  "description": "Professional music visualizer built with Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "keywords": [],
  "author": "Antigravity UI",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.2.1",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.visualizer.pro",
    "productName": "Elegant Visualizer Pro",
    "files": [
      "index.html",
      "index.js",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}